# ==============================================================================
# BIẾN MÔI TRƯỜNG DÀNH CHO MÔI TRƯỜNG VẬN HÀNH THỰC TẾ (PRODUCTION DEPLOYMENT)
# Đổi tên file này thành .env hoặc .env.production trên server của khách hàng
# ==============================================================================

# Cấu hình Ứng dụng Next.js
NODE_ENV=production
# ABT Portal dùng cổng 3008 (TBR 3005, VIA 3006, TBRs 3007 chạy trên cùng máy chủ — không dùng trùng)
PORT=3008
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://abt-portal.com

# Cấu hình Cơ sở dữ liệu PostgreSQL (Khuyên dùng mật khẩu mạnh trên 16 ký tự)
# Docker Compose: db  ·  PM2 trên máy chủ: 127.0.0.1
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me_strong_database_password
PGDATABASE=abt_portal

# Khóa ký phiên đăng nhập (cookie httpOnly). BẮT BUỘC đổi thành chuỗi ngẫu nhiên >= 32 ký tự,
# ví dụ: openssl rand -hex 32. Đổi khóa sẽ buộc mọi người đăng nhập lại.
SESSION_SECRET=change_me_to_a_random_64_hex_string

# Zalo OA: "OA Secret Key" (Zalo Developers > Webhook) để kiểm tra chữ ký sự kiện webhook.
# Chưa đặt = webhook không kiểm tra chữ ký (có thể bị giả mạo tin nhắn của Ban Giám Đốc).
ZALO_OA_SECRET_KEY=
# Số ngày hiệu lực của link PDF báo giá / hợp đồng gửi qua Zalo (mặc định 30)
DOCUMENT_LINK_TTL_DAYS=30

# ------------------------------------------------------------------------------
# Khối Kỹ thuật – Nhà máy (cùng máy chủ PostgreSQL, CSDL riêng). BẮT BUỘC PostgreSQL >= 18 (uuidv7).
# Tạo CSDL một lần:  sudo -u postgres createdb abt_factory   rồi   npm run factory:migrate
# ------------------------------------------------------------------------------
FACTORY_PGDATABASE=abt_factory
# Thư mục lưu file đính kèm của nhà máy (bản vẽ QC, COA, biên bản…). Nên nằm ngoài thư mục mã nguồn để
# "git reset --hard" khi deploy không đụng tới, và được sao lưu cùng CSDL.
FACTORY_FILE_DIR=/var/lib/abt-portal/factory-files
# KHÔNG bật trên máy chủ thật: =1 sẽ sinh dữ liệu mẫu (máy móc, lệnh sản xuất, kết quả QC giả) vào hồ sơ GMP.
FACTORY_ALLOW_DEMO_SEED=0
