# ==============================================================================
# BIẾN MÔI TRƯỜNG DÀNH CHO MÔI TRƯỜNG VẬN HÀNH THỰC TẾ (PRODUCTION DEPLOYMENT)
# Đổi tên file này thành .env hoặc .env.production trên server của khách hàng
# ==============================================================================

# Cấu hình Ứng dụng Next.js
NODE_ENV=production
PORT=3005
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://tbr-portal.vn

# Cấu hình Cơ sở dữ liệu PostgreSQL (Khuyên dùng mật khẩu mạnh trên 16 ký tự)
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=TbrPortal@EnterpriseSecure2026!
PGDATABASE=tbrs_portal

# Khóa ký phiên đăng nhập (cookie httpOnly). BẮT BUỘC đổi thành chuỗi ngẫu nhiên >= 32 ký tự,
# ví dụ: openssl rand -hex 32. Đổi khóa sẽ buộc mọi người đăng nhập lại.
SESSION_SECRET=change_me_to_a_random_64_hex_string

# Zalo OA: "OA Secret Key" (Zalo Developers > Webhook) để kiểm tra chữ ký sự kiện webhook.
# Chưa đặt = webhook không kiểm tra chữ ký (có thể bị giả mạo tin nhắn của Ban Giám Đốc).
ZALO_OA_SECRET_KEY=
# Số ngày hiệu lực của link PDF báo giá / hợp đồng gửi qua Zalo (mặc định 30)
DOCUMENT_LINK_TTL_DAYS=30
